# ==============================================================================
# ALLIED WELDING SYSTEMS UNIVERSAL ENGINE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Runtime
APP_ENV=development
PORT=8000
DEBUG=True
LOG_LEVEL=INFO
SECRET_KEY=allied_super_secret_bridge_key_change_in_production

# Monday.com v2 GraphQL API & Webhooks
MONDAY_API_KEY=your_monday_v2_api_token_here
MONDAY_API_VERSION=2026-07
# Board writes stay off until this is False (independent of Sage).
MONDAY_SIMULATION_MODE=True
# Comma-separated board ids allowed to trigger automation.
MONDAY_BOARD_ID=1234567890
# monday does NOT sign plain board webhooks. Pick one:
#  a) Plain board webhook: register https://<host>/api/v1/webhooks/monday?token=<value>
#     and put the same long random value here.
MONDAY_WEBHOOK_TOKEN=
#  b) Webhook created by a monday app: the app's Signing Secret (JWT, HS256).
MONDAY_WEBHOOK_SECRET=
# Ignore changes made by the integration's own token (prevents loops).
MONDAY_BOT_USER_ID=

# What each status label does (exact match, case-insensitive).
MONDAY_STATUS_COLUMN_ID=status
MONDAY_LABELS_CREATE_ORDER=Ready for Sage,New Order
MONDAY_LABELS_RELEASE_PO=Approved for Production,Send PO
MONDAY_LABELS_DISPATCH=Shipped,Dispatched,Dispatched / Shipped
MONDAY_CREATE_ORDER_ON_NEW_ITEM=False
# Optional: read order details from these columns instead of the item name
# convention "Customer - PO number - Item".
MONDAY_CUSTOMER_COLUMN_ID=
MONDAY_PO_COLUMN_ID=
MONDAY_ITEM_COLUMN_ID=
MONDAY_QTY_COLUMN_ID=
MONDAY_ADDRESS_COLUMN_ID=
# Optional write-back: text column for the Sage SO #, status column for sync state
# (must NOT be the trigger column above).
MONDAY_SO_COLUMN_ID=
MONDAY_SYNC_STATUS_COLUMN_ID=

# Webhook inbox retries (exponential backoff, then parked for a person).
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_RETRY_BASE_SECONDS=30
WEBHOOK_SWEEP_SECONDS=20
# Allied's system runs every automation; monday only holds data. The board
# reader checks the status column this often through the API (300s = 288 of
# the 1,000 daily calls) and uses no monday automation actions. 0 = off.
# Do not build automations inside monday: Standard allows only 250 a month.
MONDAY_POLL_SECONDS=300

# Sage 50 US Accounting Configuration
SAGE_ODBC_DSN=Peachtree
SAGE_COMPANY_PATH=C:\Sage\Peachtree\Company\AlliedWelding
SAGE_USER=allied_api
SAGE_PASSWORD=secure_sage_password
SAGE_SIMULATION_MODE=True

# Business & Compliance Rules
MIN_GROSS_MARGIN_PCT=15.0
DEFAULT_BLIND_SHIPPING=True
DEFAULT_KERF_WIDTH=0.125

# Internal File Storage / Caches
DATA_DIR=app/data
OUTPUT_DIR=output

# ==============================================================================
# JWT AUTHENTICATION & RBAC
# ==============================================================================
# CHANGE BOTH OF THESE BEFORE ANY DEPLOYMENT. The defaults are committed to the
# repository, so leaving them means anyone can forge an admin token.
# With APP_ENV=production the server refuses to start while SECRET_KEY,
# JWT_SECRET_KEY or ADMIN_PASSWORD is empty or still a value from this file.
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Pre-seeded admin account, created on first startup. In production the
# password is only used when the account is created; outside production the
# existing admin is kept in step with ADMIN_PASSWORD on every startup.
ADMIN_EMAIL=admin@alliedweldingsystems.com
ADMIN_PASSWORD=change_me_before_deploying
ADMIN_FULL_NAME=Allied System Administrator

# Serves authenticated endpoints as ADMIN when no token is supplied.
# Local development only -- deliberately separate from DEBUG so that running
# with DEBUG=True does not silently disable authentication. Keep this False.
AUTH_DEV_BYPASS=False

# ==============================================================================
# DATABASE
# ==============================================================================
# Blank resolves to sqlite:///data/allied_enterprise.db under the project root.
DATABASE_URL=

# ==============================================================================
# DEMO FIXTURES
# ==============================================================================
# Seeds sample inbox emails, reconciliations and an NCR at startup. Seeding runs
# real order orchestration and writes real records, so leave it False outside a
# throwaway demo environment.
SEED_DEMO_DATA=False

# ==============================================================================
# AI (local Ollama by default: nothing leaves the network, nothing is billed)
# ==============================================================================
OLLAMA_HOST=http://127.0.0.1:11434
# Must be pulled (`ollama list`). llama3.2 was the old default and is not installed.
OLLAMA_MODEL=qwen2.5:7b
# ollama | claude | off. "claude" needs ANTHROPIC_API_KEY + `pip install anthropic` and is billed per call.
AI_PROVIDER=ollama
AI_TEXT_MODEL=qwen2.5:7b
# Reads scanned drawings as images. Blank = text layer only. e.g. `ollama pull qwen2.5vl:7b`
AI_VISION_MODEL=
AI_CLAUDE_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=300
AI_CONTEXT_TOKENS=16384
AI_MAX_OUTPUT_TOKENS=2048
# Below this, an AI read goes to a person.
AI_CONFIDENCE_THRESHOLD=0.8
# Let AI sort inbound email before the pattern parser (falls back if AI is down).
AI_EMAIL_TRIAGE_ENABLED=False
# Transcribe call recordings on this server: `pip install faster-whisper`, e.g. small
AI_WHISPER_MODEL=
# The phone system posts transcripts to /api/v1/ai/calls?token=<this>
PHONE_WEBHOOK_TOKEN=

# ==============================================================================
# OUTBOUND NOTIFICATIONS (optional -- blank disables that channel)
# ==============================================================================
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# ==============================================================================
# MULTI-FACILITY / MULTI-CURRENCY
# ==============================================================================
DEFAULT_FACILITY=HQ
DEFAULT_CURRENCY=USD
VENDOR_PRICE_STALENESS_DAYS=60

# ==============================================================================
# PROJECTS, DESIGN-DOC SUBMISSIONS, SHIPMENTS AND STAFF ALERTS
# ==============================================================================
# Projects and milestones live on a monday board; this system reads it every
# PROJECTS_POLL_SECONDS and does all the schedule checking and alerting.
MONDAY_PROJECTS_BOARD_ID=
# subitems: items are projects, subitems are milestones | groups: groups are projects
MONDAY_PROJECTS_LAYOUT=subitems
PROJECTS_POLL_SECONDS=600
PROJECT_OWNER_COLUMN_ID=person
PROJECT_DUE_COLUMN_ID=date
PROJECT_STATUS_COLUMN_ID=status
MILESTONE_OWNER_COLUMN_ID=person
# Optional people column for who reviews design documents (blank = project owner)
MILESTONE_REVIEWER_COLUMN_ID=
MILESTONE_DUE_COLUMN_ID=date
MILESTONE_STATUS_COLUMN_ID=status
# Optional checkbox column "needs design docs"; blank = decided by these words in the name
MILESTONE_SUBMISSION_COLUMN_ID=
MILESTONE_SUBMISSION_KEYWORDS=drawing,model,calc,submission,design package,design doc
MILESTONE_DONE_LABELS=Done,Approved,Complete,Completed
MILESTONE_SUBMITTED_LABEL=Submitted
MILESTONE_APPROVED_LABEL=Approved
MILESTONE_CHANGES_LABEL=Changes requested
SUBMISSION_MAX_MB=50

# Schedule rules
BUSINESS_TZ=America/Chicago
DUE_SOON_DAYS=2
ESCALATE_AFTER_DAYS=2
REVIEW_WAIT_DAYS=2
SHIP_SLIP_DAYS=3
SHIP_SILENT_DAYS=5
SHIP_PORT_SILENT_DAYS=2
SHIP_FREE_TIME_WARN_DAYS=2
# Forwarders' email domains: their mail becomes shipment updates, e.g. bluesea.com
FORWARDER_DOMAINS=

# Alerts: in-app inbox always; email for everything; phone push for behind and
# urgent; text for urgent only. Texts and pushes wait out quiet hours and
# weekends unless urgent. Leadership gets a weekday summary at DIGEST_HOUR.
LEADERSHIP_EMAILS=
NOTIFY_COOLDOWN_HOURS=24
DIGEST_HOUR=7
QUIET_HOURS_START=21
QUIET_HOURS_END=7
QUIET_WEEKENDS=True
APP_BASE_URL=http://localhost:3000
# Free phone push: install the ntfy app and subscribe to a long random topic.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
# Texts: email-to-text gateways no longer work (AT&T ended June 2025). Twilio
# needs A2P 10DLC or toll-free verification before US texts are delivered.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
