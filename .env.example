# ==============================================================================
# ALLIED WELDING SYSTEMS UNIVERSAL ENGINE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Runtime
APP_ENV=development
PORT=8000
DEBUG=True
LOG_LEVEL=INFO
SECRET_KEY=allied_super_secret_bridge_key_change_in_production

# Monday.com v2 GraphQL API & Webhooks
MONDAY_API_KEY=your_monday_v2_api_token_here
MONDAY_API_VERSION=2026-07
# Board writes stay off until this is False (independent of Sage).
MONDAY_SIMULATION_MODE=True
# Reads only: no change of any kind is sent to monday, even with simulation
# off. Every write is blocked and logged. Turn off only for a test board.
MONDAY_READ_ONLY=True
# Comma-separated board ids allowed to trigger automation.
MONDAY_BOARD_ID=1234567890
# monday does NOT sign plain board webhooks. Pick one:
#  a) Plain board webhook: register https://<host>/api/v1/webhooks/monday?token=<value>
#     and put the same long random value here.
MONDAY_WEBHOOK_TOKEN=
#  b) Webhook created by a monday app: the app's Signing Secret (JWT, HS256).
MONDAY_WEBHOOK_SECRET=
# Ignore changes made by the integration's own token (prevents loops).
MONDAY_BOT_USER_ID=

# What each status label does (exact match, case-insensitive).
MONDAY_STATUS_COLUMN_ID=status
MONDAY_LABELS_CREATE_ORDER=Ready for Sage,New Order
MONDAY_LABELS_RELEASE_PO=Approved for Production,Send PO
MONDAY_LABELS_DISPATCH=Shipped,Dispatched,Dispatched / Shipped
MONDAY_CREATE_ORDER_ON_NEW_ITEM=False
# Optional: read order details from these columns instead of the item name
# convention "Customer - PO number - Item".
MONDAY_CUSTOMER_COLUMN_ID=
MONDAY_PO_COLUMN_ID=
MONDAY_ITEM_COLUMN_ID=
MONDAY_QTY_COLUMN_ID=
MONDAY_ADDRESS_COLUMN_ID=
# Optional write-back: text column for the Sage SO #, status column for sync state
# (must NOT be the trigger column above).
MONDAY_SO_COLUMN_ID=
MONDAY_SYNC_STATUS_COLUMN_ID=

# Webhook inbox retries (exponential backoff, then parked for a person).
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_RETRY_BASE_SECONDS=30
WEBHOOK_SWEEP_SECONDS=20
# Allied's system runs every automation; monday only holds data. The board
# reader checks the status column this often through the API (300s = 288 of
# the 1,000 daily calls) and uses no monday automation actions. 0 = off.
# Do not build automations inside monday: Standard allows only 250 a month.
MONDAY_POLL_SECONDS=300

# Sage 50 US Accounting Configuration
SAGE_ODBC_DSN=Peachtree
SAGE_COMPANY_PATH=C:\Sage\Peachtree\Company\AlliedWelding
SAGE_USER=allied_api
SAGE_PASSWORD=secure_sage_password
# Off = Sage is reached through import files (the supported mode). On connects to
# the Sage company on this machine; direct writes are not built yet.
# (Replaces SAGE_SIMULATION_MODE, which still works: True = off.)
SAGE_LIVE_CONNECTION=False

# Business & Compliance Rules
MIN_GROSS_MARGIN_PCT=15.0
DEFAULT_BLIND_SHIPPING=True
DEFAULT_KERF_WIDTH=0.125

# Internal File Storage / Caches
DATA_DIR=app/data
OUTPUT_DIR=output

# ==============================================================================
# JWT AUTHENTICATION & RBAC
# ==============================================================================
# CHANGE BOTH OF THESE BEFORE ANY DEPLOYMENT. The defaults are committed to the
# repository, so leaving them means anyone can forge an admin token.
# With APP_ENV=production the server refuses to start while SECRET_KEY,
# JWT_SECRET_KEY or ADMIN_PASSWORD is empty or still a value from this file.
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
# Browser addresses allowed to call the API, comma-separated (no wildcard).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# SQLite on a network share risks corruption; refused unless this is True.
ALLOW_NETWORK_DB=False

# Pre-seeded admin account, created on first startup. In production the
# password is only used when the account is created; outside production the
# existing admin is kept in step with ADMIN_PASSWORD on every startup.
ADMIN_EMAIL=admin@alliedweldingsystems.com
ADMIN_PASSWORD=change_me_before_deploying
ADMIN_FULL_NAME=Allied System Administrator

# Serves authenticated endpoints as ADMIN when no token is supplied.
# Local development only -- deliberately separate from DEBUG so that running
# with DEBUG=True does not silently disable authentication. Keep this False.
AUTH_DEV_BYPASS=False

# ==============================================================================
# DATABASE
# ==============================================================================
# Blank resolves to sqlite:///data/allied_enterprise.db under the project root.
DATABASE_URL=

# ==============================================================================
# DEMO FIXTURES
# ==============================================================================
# Seeds sample inbox emails, reconciliations and an NCR at startup. Seeding runs
# real order orchestration and writes real records, so leave it False outside a
# throwaway demo environment.
SEED_DEMO_DATA=False

# ==============================================================================
# AI (Groq free tier by default: fast and free, rate limited)
# ==============================================================================
# groq | ollama | claude | off. "claude" needs ANTHROPIC_API_KEY + `pip install anthropic` and is billed per call.
AI_PROVIDER=groq
# Free key at https://console.groq.com/keys. Prompts go to Groq's US servers and
# are not kept by default; also switch on Zero Data Retention under Data Controls.
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
# Reads scanned drawings (a preview model on Groq; blank = text layer only)
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Call recordings, up to 25 MB each on the free tier
GROQ_SPEECH_MODEL=whisper-large-v3-turbo
GROQ_REASONING_EFFORT=low
# Used when Groq is rate limited or down, e.g. ollama if a local model is installed. Blank = say AI is busy.
AI_FALLBACK_PROVIDER=

# Local engine (AI_PROVIDER=ollama, or the fallback)
OLLAMA_HOST=http://127.0.0.1:11434
# Must be pulled (`ollama list`). llama3.2 was the old default and is not installed.
OLLAMA_MODEL=qwen2.5:7b
AI_TEXT_MODEL=qwen2.5:7b
# Reads scanned drawings as images. Blank = text layer only. e.g. `ollama pull qwen2.5vl:7b`
AI_VISION_MODEL=
AI_CLAUDE_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=300
AI_CONTEXT_TOKENS=16384
AI_MAX_OUTPUT_TOKENS=2048
# Below this, an AI read goes to a person.
AI_CONFIDENCE_THRESHOLD=0.8
# Let AI sort inbound email before the pattern parser (falls back if AI is down).
AI_EMAIL_TRIAGE_ENABLED=False
# Local transcription of call recordings when not using Groq: `pip install faster-whisper`, e.g. small
AI_WHISPER_MODEL=
# The phone system posts transcripts to /api/v1/ai/calls?token=<this>
PHONE_WEBHOOK_TOKEN=

# ==============================================================================
# OUTBOUND NOTIFICATIONS (optional -- blank disables that channel)
# ==============================================================================
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# ==============================================================================
# MULTI-FACILITY / MULTI-CURRENCY
# ==============================================================================
DEFAULT_FACILITY=HQ
DEFAULT_CURRENCY=USD
VENDOR_PRICE_STALENESS_DAYS=60

# ==============================================================================
# PROJECTS, DESIGN-DOC SUBMISSIONS, SHIPMENTS AND STAFF ALERTS
# ==============================================================================
# Projects and milestones live on a monday board; this system reads it every
# PROJECTS_POLL_SECONDS and does all the schedule checking and alerting.
# Column settings below take the column's id, or its title as shown on the
# board (e.g. "Estimate finish"); quote titles with spaces or #. "a|b" takes
# the first of those columns that has a value.
MONDAY_PROJECTS_BOARD_ID=
# subitems: items are projects, subitems are milestones | groups: groups are projects
MONDAY_PROJECTS_LAYOUT=subitems
# Full re-read of every board, a safety net. Changes are seen sooner by the change check:
# one small read-only call for all boards, every MONDAY_CHANGE_CHECK_SECONDS in working hours
# (about 420 calls a day at these values; Standard allows about 1,000). 0 turns it off.
PROJECTS_POLL_SECONDS=3600
MONDAY_CHANGE_CHECK_SECONDS=90
MONDAY_CHANGE_CHECK_OFF_HOURS_SECONDS=900
PROJECT_OWNER_COLUMN_ID=person
PROJECT_DUE_COLUMN_ID=date
PROJECT_STATUS_COLUMN_ID=status
MILESTONE_OWNER_COLUMN_ID=person
# Optional people column for who reviews design documents (blank = project owner)
MILESTONE_REVIEWER_COLUMN_ID=
MILESTONE_DUE_COLUMN_ID=date
MILESTONE_STATUS_COLUMN_ID=status
# Optional checkbox column "needs design docs"; blank = decided by these words in the name
MILESTONE_SUBMISSION_COLUMN_ID=
MILESTONE_SUBMISSION_KEYWORDS=drawing,model,calc,submission,design package,design doc
MILESTONE_DONE_LABELS=Done,Approved,Complete,Completed
# A weekly list per owner of open milestones with no due date or owner
# (leadership gets the unowned ones). Also in the daily summary.
MILESTONE_UNPLANNED_ALERTS=True
MILESTONE_SUBMITTED_LABEL=Submitted
MILESTONE_APPROVED_LABEL=Approved
MILESTONE_CHANGES_LABEL=Changes requested
SUBMISSION_MAX_MB=50

# Schedule rules
BUSINESS_TZ=America/Chicago
DUE_SOON_DAYS=2
ESCALATE_AFTER_DAYS=2
REVIEW_WAIT_DAYS=2
SHIP_SLIP_DAYS=3
SHIP_SILENT_DAYS=5
SHIP_PORT_SILENT_DAYS=2
SHIP_FREE_TIME_WARN_DAYS=2
# Forwarders' email domains: their mail becomes shipment updates, e.g. bluesea.com
FORWARDER_DOMAINS=

# Alerts: in-app inbox always; email for everything; phone push for behind and
# urgent; text for urgent only. Texts and pushes wait out quiet hours and
# weekends unless urgent. Leadership gets a weekday summary at DIGEST_HOUR.
LEADERSHIP_EMAILS=
NOTIFY_COOLDOWN_HOURS=24
DIGEST_HOUR=7
QUIET_HOURS_START=21
QUIET_HOURS_END=7
QUIET_WEEKENDS=True
APP_BASE_URL=http://localhost:3000
# Free phone push: install the ntfy app and subscribe to a long random topic.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
# Texts: email-to-text gateways no longer work (AT&T ended June 2025). Twilio
# needs A2P 10DLC or toll-free verification before US texts are delivered.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Working hours for business-day clocks (RFQ deadlines, vendor chasers),
# in BUSINESS_TZ. Holidays are skipped: US federal days Allied closes.
BUSINESS_DAY_START=8
BUSINESS_DAY_END=17
BUSINESS_HOLIDAYS=2026-11-26,2026-11-27,2026-12-24,2026-12-25,2027-01-01,2027-05-31,2027-07-05,2027-09-06

# Vendor lead times. One monday item per vendor PO; give the column ids
# (blank = not on the board). Ship-by = project due - transit - buffer.
MONDAY_VENDOR_BOARD_ID=
VENDOR_VENDOR_COLUMN_ID=
VENDOR_PROJECT_COLUMN_ID=
VENDOR_PO_COLUMN_ID=
VENDOR_DESCRIPTION_COLUMN_ID=
VENDOR_OWNER_COLUMN_ID=
VENDOR_STATUS_COLUMN_ID=
VENDOR_ORDERED_COLUMN_ID=
VENDOR_REQUESTED_COLUMN_ID=
VENDOR_ACK_COLUMN_ID=
VENDOR_PROMISED_COLUMN_ID=
VENDOR_SHIPPED_COLUMN_ID=
VENDOR_LEAD_DAYS_COLUMN_ID=
VENDOR_MODE_COLUMN_ID=
# The customer's date, for jobs with no linked project: a date column, or a
# start date column plus a number of weeks (Allied: Vendor PO Issued + Cust Lead).
VENDOR_CUSTOMER_DUE_COLUMN_ID=
VENDOR_CUSTOMER_FROM_COLUMN_ID=
VENDOR_CUSTOMER_WEEKS_COLUMN_ID=
# True: that date is delivery to the customer, so transit is taken off. False: it's the ship date.
VENDOR_CUSTOMER_DUE_IS_DELIVERY=True
# Only items in these groups are open vendor work; other groups count as shipped. Blank = all.
# Orders already finished when first read are history and are not imported.
VENDOR_OPEN_GROUPS=
VENDOR_DONE_LABELS=Shipped,Done,Complete,Received
# Vendor door to US customer. China to the West Coast is ~5-6 weeks, East ~7-9.
VENDOR_TRANSIT_DAYS_SEA=35
VENDOR_TRANSIT_DAYS_AIR=10
VENDOR_TRANSIT_DAYS_TRUCK=5
# Vendors that ship within the US, by their board name; they get truck transit,
# every other vendor sea. Allied's 2025 orders: US vendors arrive 1-5 days after
# shipping, overseas contacts 22-38 days (8 in 10 within 35-49). Blank = every vendor overseas.
VENDOR_DOMESTIC_VENDORS=
VENDOR_BUFFER_DAYS=7
VENDOR_ACK_BUSINESS_DAYS=2
VENDOR_CHECKIN_DAYS=7
VENDOR_HISTORY_MIN_JOBS=5
VENDOR_OTD_TARGET=0.95

# Autopilot: what the system does on its own. Each play is off, suggest (messages
# to vendors or customers wait for a person to confirm) or auto. No play writes to monday.
AUTOPILOT_ENABLED=True
AUTOPILOT_MODES=rfq_board=auto,orders_watch=auto,vendor_chaser=suggest,rfq_vendor_chaser=suggest,quote_followup=suggest
AUTOPILOT_SECONDS=3600
AUTOPILOT_DRAFT_HOURS=72
# Reactions to events (an RFQ arriving or moving on, a status change on a board,
# a vendor order turning late), each off / suggest / auto. They run at once,
# in the background, and share keys with the timed plays so nothing is done twice.
AUTOPILOT_REACTIONS=rfq_acknowledge=suggest,rfq_ask_vendors=suggest,rfq_won=auto,order_shipped=auto,order_photos=auto,vendor_late_chase=suggest
AUTOPILOT_EVENTS_ASYNC=True
# Who confirms drafts: management (the reviewers below) or owner (the job's owner
# when it has one). Reviewers blank = leadership on the Alerts screen, else ADMIN_EMAIL.
AUTOPILOT_REVIEW_BY=management
AUTOPILOT_REVIEWER_EMAILS=
# Vendor contacts for names on the boards, as NAME=email pairs. Also matched
# against the vendor master (id, name, or the part before the @).
VENDOR_EMAILS=
# The monday Open RFQs board, read into the RFQ tracker (columns by id or title).
MONDAY_RFQ_BOARD_ID=
RFQ_BOARD_CUSTOMER_COLUMN_ID=Customer
RFQ_BOARD_STATUS_COLUMN_ID=Status
RFQ_BOARD_VENDORS_COLUMN_ID=Bidding vendors
RFQ_BOARD_FOLLOWUP_COLUMN_ID=Last follow up
RFQ_BOARD_STATUS_MAP=waiting on vendor quote=WAITING_VENDOR,waiting on freight=WAITING_VENDOR,waiting on drawing=CLARIFYING,need quote checked=PRICING,need markup=PRICING,need revised quote=PRICING,stuck=ACKNOWLEDGED
# Working days after a quote is sent to draft a follow-up.
QUOTE_FOLLOWUP_DAYS=2,7
# Weekly orders watch on the vendor board: unpaid orders and vendor photos waiting.
ORDERS_PAYMENT_GROUPS=Payment
ORDERS_PAYMENT_STATUS_COLUMN_ID=Payment Status
ORDERS_PAID_LABELS=Paid in Full
ORDERS_PHOTO_LABELS=EXPECTING PICS,NEED PICS APPROVED

# Customer RFQs: acknowledge within N working hours; quote within N working
# days by complexity. Waiting on a vendor's price still counts.
RFQ_ACK_BUSINESS_HOURS=4
RFQ_QUOTE_DAYS_SIMPLE=1
RFQ_QUOTE_DAYS_STANDARD=2
RFQ_QUOTE_DAYS_COMPLEX=5
RFQ_VENDOR_CHASE_DAYS=2
RFQ_VENDOR_ESCALATE_DAYS=4
# Who hears about new RFQs; blank = LEADERSHIP_EMAILS.
RFQ_TEAM_EMAILS=

# Assistant (chat widget). It reads through tools and only proposes changes;
# the person confirms each one. Third-party tools come from MCP servers:
# [{"name":"github","url":"https://.../mcp","headers":{"Authorization":"env:GITHUB_MCP_TOKEN"},"read_only_tools":["search_issues"],"min_role":"OPERATOR"}]
ASSISTANT_ENABLED=True
ASSISTANT_MAX_STEPS=5
ASSISTANT_RESULT_CHARS=4000
ASSISTANT_HISTORY_MESSAGES=10
ASSISTANT_ACTION_TTL_MINUTES=15
ASSISTANT_MCP_SERVERS=
