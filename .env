# ==============================================================================
# DEMO PROFILE  —  copy to .env before a live demonstration
#
#     copy .env.demo .env
#
# This turns ON the sample data (inbox emails, vendor reconciliations, a
# quarantined NCR) so the screens have something in them. Sage and Monday stay
# in simulation mode, so nothing reaches a real accounting system or board.
#
# Delete .env afterwards, or set SEED_DEMO_DATA=False, before using the system
# for real work — the seeded records are fictional.
# ==============================================================================

APP_ENV=demo
PORT=8000
DEBUG=True
LOG_LEVEL=INFO

# Fills the inbox feed, the reconciliation history and the compliance queue
# with realistic sample records at startup.
SEED_DEMO_DATA=True

# Leave this False. Sign in with the admin account below — the login screen is
# part of what you are demonstrating.
AUTH_DEV_BYPASS=False

ADMIN_EMAIL=admin@alliedweldingsystems.com
ADMIN_PASSWORD=AlliedEnterprise2026!
ADMIN_FULL_NAME=Allied System Administrator

# Nothing is written to a real Sage company file while this is True.
SAGE_SIMULATION_MODE=True

# No API key means Monday calls are logged, not sent.
MONDAY_API_KEY=
MONDAY_WEBHOOK_SECRET=

# Blank = no Slack/Teams messages leave the machine.
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# Local database, on this machine's own disk.
DATABASE_URL=
ALLOW_NETWORK_DB=False

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MIN_GROSS_MARGIN_PCT=15.0
VENDOR_PRICE_STALENESS_DAYS=60

# Reads scanned drawings as images (local Ollama vision model)
AI_VISION_MODEL=qwen2.5vl:7b
